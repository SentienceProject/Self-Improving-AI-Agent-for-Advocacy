__pycache__/
*.pyc
*.bak
# Outputs and state: these hold your agents' drafts, judge replies and usage.
evals/ClaudeImproverHarness/runs/
evals/ClaudeImproverHarness/results/
evals/ClaudeImproverHarness/review/
evals/ClaudeImproverHarness/techtest/
evals/ClaudeImproverHarness/external-queries-log.md
evals/legacy-rubric-eval/data/
improver_packets/
# Unlocked task folders (python3 evals/task_lock.py unlock). The repo ships only the .locked file, and your own
# *.private.md tasks never go into it.
evals/tasks*/dev/
evals/tasks*/heldout/
evals/tasks*/retired/
evals/tasks*/heldout-drafts/
evals/.unlocked-from
evals/legacy-rubric-eval/improver_tasks/
# Your own settings over config.toml (paths to your folders and the like).
evals/ClaudeImproverHarness/config.local.toml
# Earlier versions of a workspace kept to compare against (they hold your drafts and notes).
archived-workspaces/
# The private backup of your own files (scripts/private_backup.py in the workspace); it lives here because agents in
# the workspace can't read this folder.
.private-backup.git/
